# The arena server (HTTP + WebSocket on one origin). Leave it EMPTY when the
# arena serves the page itself (the single-service deployment): the page then
# talks to the origin it came from. Set it only for a page hosted elsewhere
# (Vercel) that must find the arena. Locally, empty means http://localhost:8790.
NEXT_PUBLIC_FLYPIT_SERVER=
# Deployed contracts on Robinhood Chain. Empty until the day they exist.
NEXT_PUBLIC_FLYPIT_ARENA=
NEXT_PUBLIC_FLYPIT_TOKEN=
NEXT_PUBLIC_FLYPIT_URL=https://flypit.gg
NEXT_PUBLIC_FLYPIT_X=https://x.com/flypitgg
