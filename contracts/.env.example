# Deployer key for `npm run deploy:robinhood`. Never commit a real one.
DEPLOYER_PRIVATE_KEY=
# The token the pit is played with (the launchpad's CA). Required off the hardhat network.
TOKEN_ADDRESS=
# The arena server's voucher signer (address of PAYOUT_SIGNER_KEY in server/.env).
SIGNER_ADDRESS=
# Optional: smallest deposit in whole tokens.
MIN_DEPOSIT=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=4663
