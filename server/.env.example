# ── Serving ───────────────────────────────────────────────────────────
PORT=8790
DB_PATH=./data/flypit.sqlite
# The browser origin allowed to connect ("*" while developing).
ORIGIN=*

# ── The chain ─────────────────────────────────────────────────────────
# "off" runs the pit with no chain at all (local play, tests).
# "on" watches the Arena contract and signs cash-out vouchers.
CHAIN=off
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
ARENA_ADDRESS=
TOKEN_ADDRESS=
TOKEN_SYMBOL=FLYPIT
TOKEN_DECIMALS=18
# Block the Arena was deployed at, so a fresh database does not scan from 0.
START_BLOCK=0
# Private key whose address is the Arena's `signer`. A hot key: never the owner.
PAYOUT_SIGNER_KEY=

# ── The pit ───────────────────────────────────────────────────────────
# Basis points kept from every extraction. 0 = the pit is zero-sum.
EXIT_TOLL_BPS=0
# Wallet credited with the toll (required when EXIT_TOLL_BPS > 0).
TREASURY_ADDRESS=
BOT_COUNT=18
RAIN_PER_MINUTE=30
CHECKPOINT_SECONDS=5

# ── Development only ──────────────────────────────────────────────────
# TIME_SCALE=0.25 makes the 60 s stay 15 s and the 8 s hold 2 s. Refused with CHAIN=on.
TIME_SCALE=1
# POST /dev/faucet prints lobby money. Refused with CHAIN=on.
DEV_FAUCET=false
# POST /auth/dev opens a session without a signature.
DEV_AUTH=false
